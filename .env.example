# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ── Plaid ─────────────────────────────────────────────────────────────────────
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret
PLAID_ENV=sandbox
# Run scripts/get_sandbox_token.py to obtain a sandbox access token
PLAID_ACCESS_TOKEN=access-sandbox-...
# How many months of transaction history to pull (default: 6)
PLAID_MONTHS=6

# ── ML Categorizer ────────────────────────────────────────────────────────────
# Train with: python scripts/train_categorizer.py
CATEGORIZER_MODEL_PATH=models/categorizer.pkl

# ── Audit / S3 (optional) ─────────────────────────────────────────────────────
# Leave blank to skip S3 upload; requires: pip install agentledger[cloud]
AUDIT_S3_BUCKET=
AUDIT_S3_PREFIX=audit-logs/

# ── Langfuse observability (optional) ─────────────────────────────────────────
# Run: docker-compose up langfuse  (Langfuse UI → http://localhost:3000)
# Create a project in the UI, then copy the keys below.
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=http://localhost:3000

# ── Database (used by dbt; matches docker-compose defaults) ───────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agentledger
DB_USER=agentledger
DB_PASSWORD=agentledger
